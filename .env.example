# Copy to .env and fill in. docker compose reads .env automatically; never commit .env.

# Wearable emulator on Vercel (emu/): base URL and the token it expects.
SIMULATOR_URL=
SIMULATOR_TOKEN=

# Shared secret between onboard (sender) and Earth (ingest).
EARTH_INGEST_TOKEN=

# PostgreSQL passwords. The defaults (onboard / earth) are for local development only:
# set strong values on the VPS. Changing them after the first start needs `docker compose down -v`.
ONBOARD_DB_PASSWORD=onboard
EARTH_DB_PASSWORD=earth

# Host ports. Everything except the web app binds to 127.0.0.1 only.
WEB_PORT=8080
ONBOARD_PORT=8001
EARTH_PORT=8002
ONBOARD_DB_PORT=5433
EARTH_DB_PORT=5434
