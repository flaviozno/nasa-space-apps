# Copy to .env and fill in. docker compose reads .env automatically; never commit .env.

# Wearable emulator on Vercel (app/emu/): base URL and the token it expects.
SIMULATOR_URL=https://emu-eight-umber.vercel.app
SIMULATOR_TOKEN=
SIMULATOR_TIMEOUT_S=10
INGEST_WORKER_ENABLED=true
INGEST_INTERVAL_S=60
INGEST_SESSION_ID=mvp-session-1
INGEST_BOOT_ID=mvp-boot-1
INGEST_SCENARIO=NORMAL

# Shared secret between onboard (sender) and Earth (ingest). Empty = Earth refuses every
# batch (503) and the Outbox only grows. Generate one with: openssl rand -hex 32
EARTH_INGEST_TOKEN=

# Protects PUT /api/onboard/v1/sync/link (turns the simulated Earth link on/off).
# Empty = the link cannot be changed.
ONBOARD_ADMIN_TOKEN=

# PostgreSQL passwords. The defaults (onboard / earth) are for local development only:
# set strong values on the VPS. Changing them after the first start needs
# `docker compose -f infra/docker-compose.yml down -v`.
ONBOARD_DB_PASSWORD=onboard
EARTH_DB_PASSWORD=earth

# Host ports. Everything except the web app binds to 127.0.0.1 only.
WEB_PORT=8080
ONBOARD_PORT=8001
EARTH_PORT=8002
ONBOARD_DB_PORT=5433
EARTH_DB_PORT=5434
