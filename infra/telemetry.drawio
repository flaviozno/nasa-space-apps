urce="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#4338CA;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="PUBLISH TelemetryBatch
