<mxfile host="app.diagrams.net"><diagram name="Telemetry Infrastructure Flow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1720" pageHeight="1160" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="WEARABLE · Firmware / Simulator" style="swimlane;startSize=40;rounded=1;arcSize=4;fillColor=#0F766E;strokeColor=#0F766E;fontColor=#ffffff;fontStyle=1;fontSize=15;swimlaneFillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="900" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Sampling at 1 Hz&lt;/b&gt;&lt;br&gt;HR · SpO₂ · Temp · Battery&lt;br&gt;&lt;i&gt;validityMask, sensorStatus&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n1"><mxGeometry x="30" y="70" width="240" height="90" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Non-volatile storage&lt;/b&gt;&lt;br&gt;72 h retention without BLE&lt;br&gt;persist BEFORE transmission&lt;br&gt;sampleId · deviceId · bootId · sequenceNumber" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n1"><mxGeometry x="30" y="210" width="240" height="130" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Fixed binary codec (LE)&lt;/b&gt;&lt;br&gt;Header: version, type, deviceId,&lt;br&gt;bootId, transferId, recordCount&lt;br&gt;≤100 records · ≤64 KiB&lt;br&gt;Fragmentation: fragmentIndex/Count" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n1"><mxGeometry x="30" y="400" width="240" height="150" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Retry without ACK&lt;/b&gt;&lt;br&gt;same identity&lt;br&gt;timeout 5 s · backoff 1–30 s with jitter&lt;br&gt;rejection → local quarantine" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n1"><mxGeometry x="30" y="610" width="240" height="110" as="geometry"/></mxCell><mxCell id="n6" value="ONBOARD / EDGE SERVER · Node.js + TypeScript" style="swimlane;startSize=40;rounded=1;arcSize=4;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontColor=#ffffff;fontStyle=1;fontSize=15;swimlaneFillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="420" height="900" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;BLE GATT ingestion&lt;/b&gt;&lt;br&gt;reassembly (expires after 30 s) · structure validation&lt;br&gt;device ↔ crew member binding" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n6"><mxGeometry x="30" y="70" width="360" height="90" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;SQLite&lt;/b&gt; · WAL · synchronous=FULL&lt;br&gt;samples · processing_jobs&lt;br&gt;device_bindings · audit_log&lt;br&gt;&lt;i&gt;TX: insert sample + job → ACK&lt;/i&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n6"><mxGeometry x="30" y="200" width="360" height="110" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Local worker&lt;/b&gt;&lt;br&gt;versioned rules · alerts (local, independent of Earth)&lt;br&gt;FULL encoder (≤300 s) / DELTA vs base" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n6"><mxGeometry x="30" y="350" width="360" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Outbox&lt;/b&gt; (SQLite)&lt;br&gt;alerts · encoder_state · base_archive · outbox&lt;br&gt;PENDING → IN_FLIGHT → SYNCED | QUARANTINED" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n6"><mxGeometry x="30" y="500" width="360" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Sender MQTT&lt;/b&gt;&lt;br&gt;Priority: alert › requested base › base › readings&lt;br&gt;≥20% reserved for history&lt;br&gt;backoff full jitter ≤60 s · timeout ACK 30 s&lt;br&gt;link: OFFLINE/CONNECTING/ONLINE/BACKOFF" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n6"><mxGeometry x="30" y="660" width="360" height="130" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Crew dashboard (own data)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n6"><mxGeometry x="30" y="810" width="360" height="60" as="geometry"/></mxCell><mxCell id="n13" value="BROKER MQTT 5 · TLS / mTLS" style="swimlane;startSize=40;rounded=1;arcSize=4;fillColor=#7C2D12;strokeColor=#7C2D12;fontColor=#ffffff;fontStyle=1;fontSize=15;swimlaneFillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="920" y="40" width="300" height="900" as="geometry"/></mxCell><mxCell id="n14" value="QoS 1 · retain=false&lt;br&gt;persistent session&lt;br&gt;ACL by mission / Edge / topic" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n13"><mxGeometry x="20" y="60" width="260" height="70" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;…/telemetry&lt;/b&gt;&lt;br&gt;missions/{missionId}/edges/{edgeId}/telemetry" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n13"><mxGeometry x="20" y="250" width="260" height="70" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;…/ack&lt;/b&gt;&lt;br&gt;missions/{missionId}/edges/{edgeId}/ack" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n13"><mxGeometry x="20" y="450" width="260" height="70" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;…/base-request&lt;/b&gt;&lt;br&gt;missions/{missionId}/edges/{edgeId}/base-request" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n13"><mxGeometry x="20" y="650" width="260" height="70" as="geometry"/></mxCell><mxCell id="n18" value="GROUND SERVER · TypeScript" style="swimlane;startSize=40;rounded=1;arcSize=4;fillColor=#15803D;strokeColor=#15803D;fontColor=#ffffff;fontStyle=1;fontSize=15;swimlaneFillColor=#F8FAFC;" vertex="1" parent="1"><mxGeometry x="1300" y="40" width="380" height="900" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Consumer&lt;/b&gt;&lt;br&gt;1. authenticates/authorizes Edge, mission, topic&lt;br&gt;2. validates size, version, events&lt;br&gt;3. deduplicates by eventId (conflict if content ≠)&lt;br&gt;4. ACK after commit" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n18"><mxGeometry x="30" y="220" width="320" height="120" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;PostgreSQL&lt;/b&gt; (time-series index)&lt;br&gt;events · reconstruction state&lt;br&gt;WAITING_BASE · 30-day retention" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n18"><mxGeometry x="30" y="400" width="320" height="120" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Reconstruction&lt;/b&gt;&lt;br&gt;DELTA + base FULL → exact metrics&lt;br&gt;history materialization" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n18"><mxGeometry x="30" y="580" width="320" height="90" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Ground dashboard&lt;/b&gt;&lt;br&gt;age · quality · clock · sync&lt;br&gt;STALE / MISSING / INVALID" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="n18"><mxGeometry x="30" y="730" width="320" height="110" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Protobuf contracts (onboard ↔ Earth)&lt;/b&gt; — &lt;b&gt;TelemetryBatch&lt;/b&gt; {version, batchId, edgeId, events[]} · &lt;b&gt;SpaceMessageEnvelope&lt;/b&gt; = EventMeta {eventId, missionId, edgeId, edgeSessionId, createdAtEdgeMs, dataSource, trace} + type: FULL_HEARTBEAT | DELTA_UPDATE | EMERGENCY_ALERT | DATA_GAP&lt;br&gt;&lt;b&gt;ApplicationAck&lt;/b&gt; {batchId, receiverId, persistedAtMs, acceptedEventIds[], rejected[INVALID_PAYLOAD | UNSUPPORTED_VERSION | ID_CONFLICT]} · &lt;b&gt;BaseRequest&lt;/b&gt; {requestId, edgeId, baseEventIds[]}&lt;br&gt;&lt;b&gt;BLE:&lt;/b&gt; fixed binary for data; ACK/control in Protobuf by sampleId/transferId · &lt;b&gt;Guarantee:&lt;/b&gt; at-least-once + persistence + idempotent processing · &lt;b&gt;Observability:&lt;/b&gt; W3C Trace Context — sampleId → eventId → batchId → ACK&lt;br&gt;&lt;span style='color:#64748b'&gt;Solid line = data · Dashed line = ACK / control / retry&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1640" height="150" as="geometry"/></mxCell><mxCell id="n24" value="persist" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="pending batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#334155;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="BLE GATT notifications
(char. telemetry)
