<mxfile host="app.diagrams.net" modified="2026-11-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="telemetry-mvp" name="MVP Telemetry Flow">
    <mxGraphModel dx="1680" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1100" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="nasa" value="PUBLIC NASA DATA SOURCES" style="swimlane;startSize=40;rounded=1;arcSize=8;fillColor=#7C3AED;strokeColor=#6D28D9;fontColor=#FFFFFF;fontStyle=1;fontSize=15;swimlaneFillColor=#F5F3FF;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="280" height="390" as="geometry"/></mxCell>
        <mxCell id="nasa_api" value="&lt;b&gt;NASA APIs / files&lt;/b&gt;&lt;br&gt;NLSP actigraphy / sleep&lt;br&gt;NLSP exercise test files (2)&lt;br&gt;OSDR RadLab ISS DosTel query&lt;br&gt;&lt;br&gt;Historical environmental reference&lt;br&gt;Not a personal dose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="nasa"><mxGeometry x="25" y="75" width="230" height="155" as="geometry"/></mxCell>
        <mxCell id="nasa_note" value="External network dependency&lt;br&gt;Queried on each /api/sync&lt;br&gt;4-second timeout per source&lt;br&gt;Historical data, not live crew telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="nasa"><mxGeometry x="25" y="260" width="230" height="90" as="geometry"/></mxCell>

        <mxCell id="vercel" value="VERCEL · WEARABLE EMULATOR (emu/)" style="swimlane;startSize=40;rounded=1;arcSize=8;fillColor=#0F766E;strokeColor=#0F766E;fontColor=#FFFFFF;fontStyle=1;fontSize=15;swimlaneFillColor=#F0FDFA;" vertex="1" parent="1"><mxGeometry x="390" y="70" width="360" height="650" as="geometry"/></mxCell>
        <mxCell id="vercel_api" value="&lt;b&gt;POST /api/sync&lt;/b&gt;&lt;br&gt;Bearer token · validate SyncRequest&lt;br&gt;Load NASA data · generate bounded batch&lt;br&gt;Return TelemetryBatch over HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="vercel"><mxGeometry x="30" y="75" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="fallback" value="&lt;b&gt;Bundled NASA snapshots&lt;/b&gt;&lt;br&gt;Used per source when fetch or parsing fails&lt;br&gt;Response reports LIVE / BUNDLED_SNAPSHOT" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14B8A6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="vercel"><mxGeometry x="30" y="245" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="data_mix" value="&lt;b&gt;Compose emulated wearable reading&lt;/b&gt;&lt;br&gt;NASA historical sleep context&lt;br&gt;Integrated wearable radiation sensor channel (mocked from ISS DosTel history; not personal dose)&lt;br&gt;Optional NASA exercise HR replay&lt;br&gt;Mock: SpO₂, temperature, battery, scenarios, IDs, timeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="vercel"><mxGeometry x="30" y="390" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="ack_endpoint" value="&lt;b&gt;POST /api/receipt-acks&lt;/b&gt;&lt;br&gt;Validate ACK shape only&lt;br&gt;No persistent emulator state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14B8A6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="vercel"><mxGeometry x="30" y="565" width="300" height="60" as="geometry"/></mxCell>

        <mxCell id="vps" value="VPS · DOCKER MVP" style="swimlane;startSize=40;rounded=1;arcSize=8;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontStyle=1;fontSize=15;swimlaneFillColor=#EFF6FF;" vertex="1" parent="1"><mxGeometry x="810" y="70" width="430" height="900" as="geometry"/></mxCell>
        <mxCell id="onboard_ingest" value="&lt;b&gt;Onboard scheduler + ingest&lt;/b&gt;&lt;br&gt;Every minute: build SyncRequest from durable cursors&lt;br&gt;Call Vercel emulator over HTTPS&lt;br&gt;Validate batch and convert valid metrics to observations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="vps"><mxGeometry x="35" y="75" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="onboard_db" value="&lt;b&gt;Onboard PostgreSQL&lt;/b&gt;&lt;br&gt;Sessions / cursors · readings · observations&lt;br&gt;Mission-context snapshots · operational recommendations&lt;br&gt;Alerts · Outbox · commit before ReceiptAck" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="vps"><mxGeometry x="35" y="255" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="process" value="&lt;b&gt;Onboard processing&lt;/b&gt;&lt;br&gt;Merge wearable samples + UI observations by crew and time&lt;br&gt;Mission context snapshot + baseline + fatigue check-in&lt;br&gt;→ explainable operational readiness recommendation&lt;br&gt;Persist alert events in Outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="vps"><mxGeometry x="35" y="415" width="360" height="115" as="geometry"/></mxCell>
        <mxCell id="onboard_api" value="&lt;b&gt;Onboard Crew API&lt;/b&gt;&lt;br&gt;Serve metrics, trends, alerts, questionnaires and Mission Readiness&lt;br&gt;Accept UI entries: HRV, respiration, sleep, exercise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="vps"><mxGeometry x="35" y="565" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;Crew Hub: Mission Readiness + Why this recommendation&lt;br&gt;Earth view: recommendation evidence + delivery delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="vps"><mxGeometry x="35" y="695" width="360" height="75" as="geometry"/></mxCell>
        <mxCell id="mvp_note" value="MVP boundary: HTTP replaces BLE and MQTT. No physical wearable. NASA fields are historical context; generated sensor values are mock/demo data, not clinical measurements." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="vps"><mxGeometry x="35" y="800" width="360" height="70" as="geometry"/></mxCell>

        <mxCell id="earth" value="EARTH SERVICE · SAME VPS / DOCKER" style="swimlane;startSize=40;rounded=1;arcSize=8;fillColor=#15803D;strokeColor=#15803D;fontColor=#FFFFFF;fontStyle=1;fontSize=14;swimlaneFillColor=#F0FDF4;" vertex="1" parent="1"><mxGeometry x="1320" y="410" width="300" height="440" as="geometry"/></mxCell>
        <mxCell id="earth_api" value="&lt;b&gt;Earth ingestion API&lt;/b&gt;&lt;br&gt;Private Docker network&lt;br&gt;Validate + deduplicate events&lt;br&gt;ACK after durable commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="earth"><mxGeometry x="25" y="75" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="earth_db" value="&lt;b&gt;Earth PostgreSQL&lt;/b&gt;&lt;br&gt;Received events + timestamps&lt;br&gt;Separate from onboard database" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="earth"><mxGeometry x="25" y="225" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="earth_read" value="Earth view: readings, alerts, readiness evidence + delivery delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="earth"><mxGeometry x="25" y="365" width="250" height="45" as="geometry"/></mxCell>

        <mxCell id="e1" value="fetch public data (4 sources)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vercel_api" target="nasa_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="historical NASA records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nasa_api" target="vercel_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="onboard initiates · HTTPS /api/sync · SyncRequest + Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="onboard_ingest" target="vercel_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="HTTPS · TelemetryBatch (NASA context + mock fields)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vercel_api" target="onboard_ingest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="fallback per source" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;dashed=1;endArrow=open;endFill=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fallback" target="data_mix"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="compose response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;endArrow=classic;endFill=1;" edge="1" parent="1" source="vercel_api" target="data_mix"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="persist batch + advance cursor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="onboard_ingest" target="onboard_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="after durable commit · ReceiptAck" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0F766E;dashed=1;strokeWidth=2;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="onboard_ingest" target="ack_endpoint"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="readings → observations / rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="onboard_db" target="process"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Crew API reads / writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="onboard_api" target="onboard_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="UI metric entries + dashboard reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4F46E5;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="web" target="onboard_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="enabled Earth link · pending Outbox events; readiness review prioritized" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803D;strokeWidth=2;endArrow=classic;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="process" target="earth_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="durable ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803D;dashed=1;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="earth_api" target="process"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803D;endArrow=classic;endFill=1;" edge="1" parent="1" source="earth_api" target="earth_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="Earth data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15803D;endArrow=classic;endFill=1;" edge="1" parent="1" source="earth_db" target="earth_read"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="read via Earth endpoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4F46E5;dashed=1;endArrow=classic;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="earth_read" target="web"><mxGeometry relative="1" as="geometry"/></mxCell>
