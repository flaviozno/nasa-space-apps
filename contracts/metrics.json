      "unit": "score",
      "source": "questionnaire",
      "questionnaire": "phq4",
      "scale": [0, 12],
      "scaleLabel": "4 questions scored 0-3; total 0-12"
    },
    {
      "id": "team_climate",
      "label": "Team climate",
      "unit": "score",
      "source": "questionnaire",
      "questionnaire": "team_climate",
