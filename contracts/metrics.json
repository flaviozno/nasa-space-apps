{
  "version": 1,
  "description": "Metric catalog for the Astronaut Health Hub. Single source of truth for metric IDs, labels, units, scales, and data-source kind. Every observation must reference a metric id from this file. Owner: Matheus. Changes only through an announced PR.",
  "notes": {
    "alignment": "IDs, units, sources, and scales MUST match the metrics dictionary in crew.json (contracts/crew.json). Validated by contracts/tests and by the Crew API at startup.",
    "source": "wearable = metric assigned to the wearable channel; manual = measurement entered by the astronaut in the UI; questionnaire = answered in a form.",
    "scale": "Inclusive [min, max]. A value outside the scale, or null, is INVALID (never 0).",
    "generatedByEmulator": "For wearable metrics only. The current emulator generates heart_rate, spo2, and body_temp. hrv_rmssd, resp_rate, sleep_duration, and exercise_duration remain wearable metrics, but the MVP UI is their input path because the emulator does not emit them yet. The target wearable also has a radiation sensor; its MVP demo channel uses historical ISS DosTel references.",
    "deviceTelemetry": "batteryMillivolts and radiation are device telemetry in TelemetryBatch, not crew-health metrics in this catalog.",
    "zScore": "z = (value - median) / spread with the fixed baselines in crew.json. Alert threshold |z| >= 3 (ALERT_Z in contracts/tests/test_crew_baseline.py).",
    "questionnaires": "daily_checkin = mood, stress, fatigue, sleepiness (KSS), and the six symptom_* metrics. phq4 and team_climate submit only their total as an observation; raw per-question answers are stored with the questionnaire response."
  },
  "metrics": [
    {
      "id": "heart_rate",
      "label": "Heart rate",
      "unit": "bpm",
      "source": "wearable",
      "scale": [30, 220],
      "generatedByEmulator": true
    },
    {
      "id": "hrv_rmssd",
      "label": "HRV (RMSSD)",
      "unit": "ms",
      "source": "wearable",
      "scale": [5, 400]
    },
    {
      "id": "spo2",
      "label": "Blood oxygen (SpO2)",
      "unit": "%",
      "source": "wearable",
      "scale": [0, 100],
      "generatedByEmulator": true
    },
    {
      "id": "resp_rate",
      "label": "Respiration rate",
      "unit": "breaths/min",
      "source": "wearable",
      "scale": [6, 40]
    },
    {
      "id": "body_temp",
      "label": "Body temperature",
      "unit": "°C",
      "source": "wearable",
      "scale": [35, 41],
      "generatedByEmulator": true
    },
    {
      "id": "sleep_duration",
      "label": "Sleep duration",
      "unit": "h",
      "source": "wearable",
      "scale": [0, 24]
    },
    {
      "id": "exercise_duration",
      "label": "Exercise duration",
      "unit": "min/day",
      "source": "wearable",
      "scale": [0, 1440]
    },
    {
      "id": "body_mass",
      "label": "Body mass",
      "unit": "kg",
      "source": "manual",
      "scale": [40, 150]
    },
    {
      "id": "blood_pressure_systolic",
      "label": "Blood pressure (systolic)",
      "unit": "mmHg",
      "source": "manual",
      "scale": [70, 200]
    },
    {
      "id": "blood_pressure_diastolic",
      "label": "Blood pressure (diastolic)",
      "unit": "mmHg",
      "source": "manual",
      "scale": [40, 130]
    },
    {
      "id": "water_intake",
      "label": "Water intake",
      "unit": "L/day",
      "source": "manual",
      "scale": [0, 10]
    },
    {
      "id": "grip_strength",
      "label": "Grip strength",
      "unit": "kg",
      "source": "manual",
      "scale": [10, 100]
    },
    {
      "id": "mood",
      "label": "Mood",
      "unit": "score",
      "source": "questionnaire",
      "questionnaire": "daily_checkin",
      "scale": [1, 10],
      "scaleLabel": "1 = very bad, 10 = very good"
    },
    {
      "id": "stress",
      "label": "Stress",
      "unit": "score",
      "source": "questionnaire",
      "questionnaire": "daily_checkin",
      "scale": [1, 10],
      "scaleLabel": "1 = none, 10 = extreme"
    },
    {
      "id": "fatigue",
      "label": "Fatigue",
      "unit": "score",
      "source": "questionnaire",
      "questionnaire": "daily_checkin",
      "scale": [1, 10],
      "scaleLabel": "1 = none, 10 = extreme"
    },
    {
      "id": "sleepiness",
      "label": "Sleepiness (KSS)",
      "unit": "KSS",
      "source": "questionnaire",
      "questionnaire": "daily_checkin",
      "scale": [1, 9],
      "scaleLabel": "Karolinska Sleepiness Scale: 1 = extremely alert, 9 = very sleepy"
    },
    {
      "id": "symptom_headache",
      "label": "Headache",
      "unit": "score",
